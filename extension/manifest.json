{
  "manifest_version": 3,
  "name": "DSH Tab Bridge",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH Tab Bridge"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dsh-tab-bridge@xiamubumu.github.io",
      "strict_min_version": "121.0"
    }
  }
}
